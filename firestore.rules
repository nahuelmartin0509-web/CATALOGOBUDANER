rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos públicos del catálogo: cualquiera lee, solo el admin autenticado escribe.
    match /vehicles/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Precio / Costo: NUNCA público. Solo usuarios autenticados.
    match /vehicles_private/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
